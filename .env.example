# Variables de entorno para configuración segura
# Copia este archivo a .env y rellena con tus claves reales

# Clave secreta de Stripe (obtén de https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Secreto del webhook de Stripe (configura en https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here